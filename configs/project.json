{
  "project_name": "TryOps",
  "theme": "Enterprise MLOps for VTON and optimized LLM serving",
  "environment_order": ["local", "staging", "production_demo"],
  "workloads": ["vton", "llm"],
  "registry": {
    "tracking": "mlflow",
