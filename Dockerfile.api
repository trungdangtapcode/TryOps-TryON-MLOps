FROM python:3.12-slim-bookworm

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
RUN pip install --no-cache-dir fastapi uvicorn prometheus-client psycopg2-binary minio
ENV PYTHONPATH=/app/src
EXPOSE 8080
RUN addgroup --system tryops && adduser --system --ingroup tryops --home /nonexistent --no-create-home tryops
USER tryops
CMD ["uvicorn", "tryops.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
