{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TryOps Feedback Event",
  "type": "object",
  "required": ["event_id", "request_id", "workload", "model_alias", "rating", "created_at"],
  "properties": {
    "event_id": {"type": "string"},
    "request_id": {"type": "string"},
    "workload": {"type": "string", "enum": ["vton", "llm"]},
    "model_alias": {"type": "string"},
    "rating": {"type": "integer", "minimum": 1, "maximum": 5},
    "failure_labels": {
      "type": "array",
      "items": {"type": "string"}
    },
    "comment": {
      "type": "string",
      "maxLength": 1000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

