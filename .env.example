# Copy to .env for local Compose runs and replace every change-me value.
# The committed Compose file reads sensitive values through Compose secrets.

TRYOPS_POSTGRES_USER=tryops
TRYOPS_POSTGRES_DB=tryops
# TRYOPS_POSTGRES_PASSWORD=change-me-postgres-password
TRYOPS_POSTGRES_PASSWORD=tryops-local-postgres

TRYOPS_MINIO_ROOT_USER=tryops
TRYOPS_MINIO_ROOT_PASSWORD=change-me-minio-root-password
TRYOPS_MINIO_DATA_DIR=./artifacts/minio-data
TRYOPS_ARTIFACT_BUCKET=tryops-artifacts

TRYOPS_GATEWAY_QUOTA_POSTGRES_DSN=host=postgres port=5432 user=tryops password=change-me-postgres-password dbname=tryops
TRYOPS_POSTGRES_BACKUP_DSN=postgres://tryops:change-me-postgres-password@postgres:5432/tryops?sslmode=disable
TRYOPS_GATEWAY_TLS_PORT=8443

TRYOPS_KEYCLOAK_PORT=18082
TRYOPS_KEYCLOAK_ADMIN=tryops-admin
TRYOPS_KEYCLOAK_ADMIN_PASSWORD=tryops-local-keycloak

# Optional TLS profile secrets for `docker compose --profile tls up gateway-tls`.
# Provide PEM contents through your secret manager in production.
TRYOPS_TLS_CERT_PEM=
TRYOPS_TLS_KEY_PEM=

TRYOPS_WEBHOOK_SECRET=change-me-registry-webhook-secret
TRYOPS_GITHUB_WEBHOOK_SECRET=change-me-github-webhook-secret
TRYOPS_CONTROLLER_POLICY_CLI=artifacts/native/tryops_policy_cli

# Optional production secret-management profile.
# Use a real Vault/External Secrets deployment; never commit live tokens or secret values.
VAULT_ADDR=
TRYOPS_VAULT_ROLE=tryops-runtime
TRYOPS_WORKLOAD_IDENTITY_TOKEN_PATH=/var/run/secrets/tryops/vault/token

# Production model serving. Defaults require real model endpoints; deterministic
# baselines are diagnostics only and must not be exposed to end users.
TRYOPS_REQUIRE_REAL_MODELS=1
TRYOPS_ALLOW_DETERMINISTIC_BASELINE=0
TRYOPS_ALLOW_LLM_SEMANTIC_CACHE=0
TRYOPS_ALLOW_LEXICAL_SEMANTIC_CACHE=0
TRYOPS_ENABLE_LOCAL_API_KEYS=0
TRYOPS_ENABLE_DEV_API_KEY_FALLBACK=0

# Local vLLM/OpenAI-compatible serving. For Docker Compose, host.docker.internal
# points from the API container to a vLLM server running on the host.
# Start one with:
#   vllm serve HuggingFaceTB/SmolLM2-135M-Instruct --host 127.0.0.1 --port 8000
TRYOPS_LLM_PROVIDER=openai_compatible
TRYOPS_LLM_BASE_URL=http://host.docker.internal:8000/v1
TRYOPS_LLM_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct
TRYOPS_LLM_API_KEY=
TRYOPS_LLM_TIMEOUT_SECONDS=120
TRYOPS_LLM_TEMPERATURE=0
TRYOPS_LLM_INPUT_COST_PER_1K_USD=0
TRYOPS_LLM_OUTPUT_COST_PER_1K_USD=0

# Real FASHN VTON router and Hugging Face cache locations. Keep these under
# artifacts/ so NFS/home cache permission issues do not break weight downloads.
TRYOPS_REAL_VTON_URL=http://host.docker.internal:18100
TRYOPS_FASHN_GPU_IDS=0
TRYOPS_FASHN_WORKER_TRANSPORT=unix
TRYOPS_FASHN_WORKER_SOCKET_DIR=artifacts/runtime/fashn-workers
TRYOPS_FASHN_WORKER_BASE_PORT=43100
TRYOPS_FASHN_WORKER_PRELOAD=1
TRYOPS_FASHN_REQUIRE_CUDA=1
TRYOPS_FASHN_ALLOW_CPU_FALLBACK=0
HF_HOME=artifacts/hf-home
HF_HUB_CACHE=artifacts/hf-home/hub
HF_XET_CACHE=artifacts/hf-home/xet
HF_HUB_DISABLE_XET=1
HF_TOKEN=
XDG_CACHE_HOME=artifacts/cache/xdg
TMPDIR=artifacts/cache/tmp

# VTON async job capacity. Keep workers low on local machines; each real VTON
# worker can hold expensive GPU/CPU memory. Plan limits are per workspace.
TRYOPS_VTON_JOB_WORKERS=1
TRYOPS_VTON_CONCURRENCY_FREE=1
TRYOPS_VTON_CONCURRENCY_TEAM=2
TRYOPS_VTON_CONCURRENCY_ENTERPRISE=4

# Local observability. `make app-up` enables this by default so Grafana can
# inspect API, async job, gateway, and FASHN VTON logs through Loki.
TRYOPS_OBSERVABILITY=1
TRYOPS_GRAFANA_PORT=13000
TRYOPS_GRAFANA_THEME=dark
TRYOPS_LOKI_PORT=13100
TRYOPS_TEMPO_PORT=13200
TRYOPS_OTEL_BRIDGE_PORT=19122
FASHN_VTON_STRUCTURED_LOG=artifacts/logs/fashn_vton_events.jsonl
FASHN_VTON_ROUTER_STRUCTURED_LOG=artifacts/logs/fashn_vton_router_events.jsonl
