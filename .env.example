# Copy to .env for local Compose runs and replace every change-me value.
# The committed Compose file reads sensitive values through Compose secrets.

TRYOPS_POSTGRES_USER=tryops
TRYOPS_POSTGRES_DB=tryops
# TRYOPS_POSTGRES_PASSWORD=change-me-postgres-password
TRYOPS_POSTGRES_PASSWORD=tryops-local-postgres

TRYOPS_MINIO_ROOT_USER=tryops
TRYOPS_MINIO_ROOT_PASSWORD=change-me-minio-root-password

TRYOPS_GATEWAY_QUOTA_POSTGRES_DSN=host=postgres port=5432 user=tryops password=change-me-postgres-password dbname=tryops
TRYOPS_POSTGRES_BACKUP_DSN=postgres://tryops:change-me-postgres-password@postgres:5432/tryops?sslmode=disable
TRYOPS_GATEWAY_TLS_PORT=8443

# Optional TLS profile secrets for `docker compose --profile tls up gateway-tls`.
# Provide PEM contents through your secret manager in production.
TRYOPS_TLS_CERT_PEM=
TRYOPS_TLS_KEY_PEM=

TRYOPS_WEBHOOK_SECRET=change-me-registry-webhook-secret
TRYOPS_GITHUB_WEBHOOK_SECRET=change-me-github-webhook-secret
TRYOPS_CONTROLLER_POLICY_CLI=artifacts/native/tryops_policy_cli

# Optional production secret-management profile.
# Use a real Vault/External Secrets deployment; never commit live tokens or secret values.
VAULT_ADDR=
TRYOPS_VAULT_ROLE=tryops-runtime
TRYOPS_WORKLOAD_IDENTITY_TOKEN_PATH=/var/run/secrets/tryops/vault/token

# Optional model/provider secrets. Leave blank for deterministic offline fallbacks.
ANTHROPIC_API_KEY=
